{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "ESNext.Disposable"
    ],
    "baseUrl": "../..",
    "paths": {
      "@inferdi/inferdi": [
        "packages/inferdi/src/index.ts"
      ]
    },
    "skipLibCheck": true
  },
  "include": [
    "snippets/**/*.ts"
  ]
}
