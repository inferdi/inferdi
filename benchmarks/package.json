{
  "name": "di-benchmarks",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "description": "Comparative DI container benchmarks.",
  "scripts": {
    "bench": "node scripts/run-benchmarks.mjs --mode quick",
    "bench:quick": "node scripts/run-benchmarks.mjs --mode quick",
    "bench:source": "node scripts/run-benchmarks.mjs --mode quick --artifact source",
    "bench:public": "node scripts/run-benchmarks.mjs --mode public",
    "bench:report": "node scripts/report-benchmarks.mjs",
    "precondition": "vitest run src/precondition",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "inversify": "^8.2.3",
    "awilix": "^13.0.5",
    "tsyringe": "^4.10.0",
    "typedi": "^0.10.0",
    "typed-inject": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "tinybench": "2.9.0",
    "vitest": "^4.1.11",
    "unplugin-swc": "^1.5.9",
    "@swc/core": "^1.15.33",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
